<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.local.wifimac" android:versionCode="8" android:versionName="0.6.0-mlo-experimental">
  <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="35" />
  <permission android:name="dev.local.wifimac.permission.CONTROL" android:protectionLevel="signature" />
  <uses-permission android:name="dev.local.wifimac.permission.CONTROL" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
